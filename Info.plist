<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ── App ───────────────────────────────────────────────── -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- Langues de l'app : sans elles, les éléments du système (Annuler,
         Copier, partage, lecteur vidéo…) restaient en anglais. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>fr</string>
        <string>es</string>
        <string>ru</string>
        <string>it</string>
        <string>ja</string>
        <string>zh-Hant</string>
    </array>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>TwitchUnblock</string>
    <key>CFBundleDisplayName</key>
    <string>TwitchUnblock</string>
    <key>CFBundleIdentifier</key>
    <string>com.mxfia19.TwitchUnblock</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.1</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Jeton de comptage : vide ici, la CI du dépôt officiel y met un secret
         que les forks n'héritent pas (voir .github/workflows/build.yml). -->
    <key>TUPingKey</key>
    <string></string>

    <!-- ── Deep Link URL Scheme (twitchunblock://) ───────────── -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>twitchunblock</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.mxfia19.TwitchUnblock</string>
        </dict>
    </array>

    <!-- ── Background Modes (audio + PiP) ────────────────────── -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.mxfia19.TwitchUnblock.liveRefresh</string>
    </array>

    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
    </array>

    <!-- ── Live Activity du lecteur (extension TwitchUnblockWidgets) ── -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- ── External app URL schemes (canOpenURL whitelist) ────── -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>vlc</string>
        <string>outplayer</string>
        <string>infuse</string>
        <string>feather</string>
        <string>sidestore</string>
        <string>altstore</string>
    </array>

    <!-- ── Privacy ───────────────────────────────────────────── -->
    <key>NSCameraUsageDescription</key>
    <string>This app doesn't use the camera.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>This app doesn't use the microphone.</string>

    <!-- ── ATS : HTTPS partout, sauf pour la lecture vidéo (AVPlayer) ── -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsForMedia</key>
        <true/>
        <!-- VODs téléchargées : lues par le petit serveur de l'app, sur 127.0.0.1 -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- ── Orientation ────────────────────────────────────────── -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- ── Status bar ─────────────────────────────────────────── -->
    <!-- Laissée aux contrôleurs : le lecteur en grand la masque
         (statusBarHidden, MainTabView). L'iPhone la cache seul en paysage,
         pas l'écran intérieur de l'iPhone Duo, où sa colonne restait sur le
         côté de l'image. Texte clair : l'app est toujours en sombre. -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- ── Apparence : toujours sombre (écran de lancement compris) ── -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- ── Launch screen (fond système : noir en apparence sombre) ── -->
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
